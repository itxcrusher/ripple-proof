          "columns": ["user_id"],
          "evidence": "column"
        }
      ],
      "repositories": [
        {
          "name": "warehouse",
          "models": [
            {
              "path": "models/orders_quoted.sql",
              "name": "orders_quoted",
              "alias": "orders_quoted",
              "sql": "-- user_id remains documentation\nselect\n    \"orders\".\"user_id\",\n    'user_id' as source_label,\n    user_id_suffix\nfrom analytics.orders as orders\nwhere \"orders\".\"user_id\" is not null"
            }
          ]
        }
      ],
      "assertions": {
        "patchCount": 1,
        "unresolvedCount": 0,
        "preservedOutputAliases": 1,
        "modelContains": [
          "\"orders\".\"customer_id\" as \"user_id\"",
          "-- user_id remains documentation",
          "'user_id' as source_label",
          "user_id_suffix"
        ]
      }
    },
