# Copy to .env (gitignored) and fill in. NEVER commit the real .env.
# Generate via: datahub init --username datahub --password datahub --token-duration no_expiry --force
# (writes ~/.datahubenv; copy the token value from there into DATAHUB_GMS_TOKEN below)
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=

# Optional AI-backed instruction parsing. Planning always defaults to the strict
# deterministic "rename X to Y" parser, even when this key exists. The key is
# used only when you explicitly run RippleProof with --generator llm.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
