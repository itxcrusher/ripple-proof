{
  "schemaVersion": 1,
  "cases": [
    {
      "id": "preserve-simple-boundary",
      "title": "Preserve a direct downstream contract",
      "category": "supported-repair",
      "expectedDecision": "automate",
      "mode": "preserve",
      "assets": [
        {
          "urn": "urn:li:dataset:(urn:li:dataPlatform:dbt,orders_daily,PROD)",
          "type": "DATASET",
          "name": "orders_daily",
          "platform": "dbt",
          "degree": 1,
          "columns": ["user_id"],
          "evidence": "column"
        }
      ],
      "repositories": [
        {
          "name": "warehouse",
          "models": [
            {
              "path": "models/orders_daily.sql",
              "name": "orders_daily",
              "alias": "orders_daily",
              "sql": "select\n    user_id,\n    sum(order_total) as total_revenue\nfrom analytics.orders\nwhere user_id is not null\ngroup by user_id"
            }
          ]
        }
      ],
      "assertions": {
        "patchCount": 1,
        "contractPatchCount": 0,
        "protectedCount": 0,
        "unresolvedCount": 0,
        "preservedOutputAliases": 1,
        "modelContains": [
          "customer_id as user_id",
          "where customer_id is not null",
          "group by customer_id"
        ]
      }
    },
    {
      "id": "preserve-quoted-inert-text",
      "title": "Rewrite quoted identifiers without touching inert text",
      "category": "sql-token-safety",
      "expectedDecision": "automate",
      "mode": "preserve",
      "assets": [
        {
          "urn": "urn:li:dataset:(urn:li:dataPlatform:dbt,orders_quoted,PROD)",
          "type": "DATASET",
          "name": "orders_quoted",
